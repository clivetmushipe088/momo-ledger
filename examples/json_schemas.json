  },

  "x-sql-to-json-mapping": {
    "rules": [
      "Column names are kept as-is (snake_case), so a JSON field can be traced straight back to its column.",
      "Foreign keys are replaced by the nested object they point to: transactions.category_id -> transaction.category, transactions.user_id -> transaction.user.",
      "The M:N junction table transaction_parties becomes the array transaction.parties; each item holds the role and the embedded party.",
      "system_logs rows with a matching transaction_id become the array transaction.logs.",
      "DECIMAL -> string with 2 decimals; DATETIME -> ISO 8601 string with +02:00; ENUM -> string limited by enum; NULL -> null (the key is always present).",
      "Never serialized: users.password_hash, sessions.token, unmatched_sms.body_hash."
    ],
    "transaction": [
      { "sql": "transactions.transaction_id",   "sql_type": "BIGINT UNSIGNED",  "json": "transaction_id",        "json_type": "integer" },
      { "sql": "transactions.sms_ref",          "sql_type": "VARCHAR(30) NULL", "json": "sms_ref",               "json_type": "string | null" },
      { "sql": "transactions.amount",           "sql_type": "DECIMAL(12,2)",    "json": "amount",                "json_type": "string (money)" },
      { "sql": "transactions.fee",              "sql_type": "DECIMAL(10,2)",    "json": "fee",                   "json_type": "string (money)" },
      { "sql": "transactions.balance_after",    "sql_type": "DECIMAL(12,2) NULL", "json": "balance_after",       "json_type": "string (money) | null" },
      { "sql": "transactions.currency",         "sql_type": "CHAR(3)",          "json": "currency",              "json_type": "string" },
      { "sql": "transactions.transaction_date", "sql_type": "DATETIME",         "json": "transaction_date",      "json_type": "string (ISO 8601)" },
      { "sql": "transactions.status",           "sql_type": "ENUM",             "json": "status",                "json_type": "string (enum)" },
      { "sql": "transactions.raw_sms",          "sql_type": "TEXT NULL",        "json": "raw_sms",               "json_type": "string | null" },
      { "sql": "transactions.created_at",       "sql_type": "DATETIME",         "json": "created_at",            "json_type": "string (ISO 8601)" },
      { "sql": "transactions.updated_at",       "sql_type": "DATETIME",         "json": "updated_at",            "json_type": "string (ISO 8601)" },
      { "sql": "transactions.category_id -> transaction_categories.*", "sql_type": "FK (N:1)", "json": "category", "json_type": "object" },
      { "sql": "transactions.user_id -> users.user_id, username, full_name", "sql_type": "FK (N:1)", "json": "user", "json_type": "object" },
      { "sql": "transaction_parties.party_role + parties.*", "sql_type": "junction (M:N)", "json": "parties[]", "json_type": "array of { role, party }" },
      { "sql": "system_logs.* WHERE transaction_id = ?", "sql_type": "FK (1:N)", "json": "logs[]", "json_type": "array of object" }
    ]
  }
}
